+            if (evt->dev == DEVICE_DT_GET(DT_NODELABEL(trackball))) {
+                // Screen Y increases downward, so positive angles rotate clockwise.
+                // Q15 coefficients for cos(20 degrees) and sin(20 degrees).
+                const int32_t scale = 32768;
+                const int32_t cosine = 32270;
+                const int32_t sine = 5690;
+                static int32_t x_remainder;
+                static int32_t y_remainder;
+
+                // Carry fractional counts to the next report at low speeds.
+                int32_t rotated_x = cosine * x - sine * y + x_remainder;
+                int32_t rotated_y = sine * x + cosine * y + y_remainder;
+                x = CLAMP(rotated_x / scale, INT16_MIN, INT16_MAX);
+                y = CLAMP(rotated_y / scale, INT16_MIN, INT16_MAX);
+                x_remainder = rotated_x % scale;
+                y_remainder = rotated_y % scale;
+            }
+            zmk_hid_mouse_movement_set(x, y);
         }
 
